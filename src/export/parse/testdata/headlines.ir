preamble
  keyword TITLE @0 "Headlines"
  keyword AUTHOR @1 "Someone"
  paragraph @2 "Text before the first headline."
headline 1 @4 TODO [#A] "A task with everything" :work:urgent:
  scheduled "<2026-01-05 Mon>"
  deadline "<2026-01-09 Fri>"
  property CUSTOM_ID "task"
  property EXPORT_FILE_NAME "task-out"
  paragraph @10 "The section."
  headline 2 @11 DONE "Finished"
    closed "[2026-01-02 Fri 10:00]"
  headline 2 @13 COMMENT "Not exported"
    paragraph @14 "Hidden."
    headline 3 @15 "Child of a comment"
headline 1 @16 NEXT ""
headline 1 @17 "Plain heading with a colon: not tags"
headline 1 @18 "Tags only" :a:
  paragraph @19 "**bold** at the start of a line is not a headline.\n*"
headline 1 @21 "A block that crosses a headline"
  paragraph @22 "#+begin_src sh\necho one"
headline 1 @24 "This is a headline, so the block above never closed"
  paragraph @25 "#+end_src"
  headline 5 @26 "Deep, skipping levels"
headline 1 @27 "Back to the top"
